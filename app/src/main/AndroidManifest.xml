<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- Feature E (completeness pass, spec section 6 / SPEC.md section 4.1): AlarmManager exact
         alarms for every reminder type. WorkManager is unreliable for time-of-day reminders on
         this OEM and is reserved for Health Connect sync only. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- API 33+ runtime permission, requested from the new ReminderSetupStep onboarding step. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission (auto-granted); lets BootCompletedReceiver reschedule alarms, which
         don't survive a reboot on their own. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".StrideApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Health Connect refuses to list an app as a valid permission requester unless it can
              show a "why does this app want my data" rationale screen. Android 14+ looks for this
              intent-filter directly; devices whose Health Connect predates 14 look for the
              ViewPermissionUsageActivity alias below instead. Without either, the app never
              appears in Health Connect's UI at all (not even as "not allowed") and
              PermissionController's request silently no-ops.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Feature E (completeness pass, spec section 6): one receiver for all three reminder
             types (scheduled fire + direct-reply), never exported: only ever targeted by this
             app's own AlarmManager/notification PendingIntents, never by an external broadcast. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Alarms don't survive a reboot; this reschedules everything from the DB once the
             device finishes booting (SPEC.md section 4.1). BOOT_COMPLETED is a protected system
             broadcast, so this must be exported for the system to deliver it. -->
        <receiver
            android:name=".reminders.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
